          "blocks": [
            { "question": "How do I find my size?", "answer": "Check the size chart on each product page — measurements are listed in centimetres. If you're between sizes, we recommend sizing up for a relaxed fit." },
            { "question": "What's your return policy?", "answer": "Items can be returned within 30 days of delivery, unworn and with tags attached, for a full refund." },
            { "question": "Do you offer exchanges?", "answer": "Yes — start a return and choose \"exchange\" at checkout, or contact us and we'll help you find the right size." },
            { "question": "How long does shipping take?", "answer": "Orders typically arrive within 3-5 business days. You'll get a tracking link as soon as your order ships." },
            { "question": "Is Cash on Delivery available?", "answer": "Where enabled, COD is offered at checkout for eligible pin codes." }
