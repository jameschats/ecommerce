      "sections": [
        {
          "type": "FaqAccordion", "title": "Care & assembly",
          "settings": { "heading": "Care & assembly" },
          "blocks": [
            { "question": "Is assembly included?", "answer": "Free assembly is included on select furniture — look for the \"Free assembly\" badge on the product page. Otherwise, clear step-by-step instructions are included in the box." },
            { "question": "How do I care for solid wood pieces?", "answer": "Dust with a dry or slightly damp cloth, avoid direct sunlight and heat sources, and use coasters/placemats to prevent water rings. A light furniture wax every few months keeps the finish healthy." },
            { "question": "What's your warranty?", "answer": "All furniture is covered by a 1-year warranty against manufacturing defects. Everyday wear and accidental damage aren't covered." },
            { "question": "How long does delivery take?", "answer": "Most items arrive within 5-10 business days. Larger furniture may take longer — you'll see an estimated delivery window on the product page." },
            { "question": "What's your return policy?", "answer": "Items can be returned within 30 days of delivery in their original condition. Made-to-order pieces may not be eligible — check the product page." }
          ]
        }
      ]
