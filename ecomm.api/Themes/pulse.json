        {
          "type": "FaqAccordion", "title": "FAQ",
          "settings": { "heading": "Frequently asked" },
          "blocks": [
            { "question": "Is everything brand new and sealed?", "answer": "Yes. We only sell genuine, brand-new, factory-sealed products from authorised distributors — never grey imports or refurbished stock unless clearly labelled." },
            { "question": "What warranty do I get?", "answer": "Every device comes with a minimum 2-year warranty covering manufacturing faults. Extended cover is available on selected products at checkout." },
            { "question": "How fast is delivery?", "answer": "Order by 9pm on a weekday for free next-day delivery. Named-day and timed slots are available at checkout for a small fee." },
            { "question": "Can I return a product?", "answer": "Yes — return any unopened item within 30 days for a full refund. Opened items can be returned if faulty, and we cover the postage." },
            { "question": "Do you price match?", "answer": "If you find the same sealed, warrantied product cheaper at a UK authorised retailer, contact us and we'll do our best to match it." }
          ]
        }
