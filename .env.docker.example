# Copy to .env.docker (gitignored) and fill in for local container testing.
# On the VPS, the real deploy points env_file at /etc/wavcomm/api.env instead of this file -
# see documents/v4-stages/phase-0-portability.md "Deploy notes".

# Dev-placeholder DB, matches CLAUDE.md's documented local default - not a real secret.
ConnectionStrings__Default=Server=host.docker.internal;Database=ecommerce;Uid=root;Pwd=admin;CharSet=utf8mb4;
ASPNETCORE_ENVIRONMENT=Docker
Jwt__Key=dev-only-local-container-test-key-not-for-production-use
Cors__AngularOrigin=http://localhost:4010
Tenancy__BaseDomain=localhost
Tenancy__DefaultTenantId=1
Ai__Provider=None
Ai__ImageProvider=None
Payments__Provider=Mock
