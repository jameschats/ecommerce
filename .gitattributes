# Shell scripts and server config must keep LF endings. Git on Windows converts to CRLF
# on checkout by default, and a CRLF shell script fails on Linux with confusing errors
# ("\r: command not found", "unexpected end of file").
*.sh            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.env           text eol=lf
database/migrations/*.sql text eol=lf
